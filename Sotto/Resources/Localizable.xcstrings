    "Choose a key to activate dictation.\nHold it to talk, release to transcribe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Taste zum Aktivieren.\nHalte sie gedrückt zum Sprechen, lasse los zum Transkribieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una tecla para activar el dictado.\nMantenla pulsada para hablar, suéltala para transcribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une touche pour activer la dictée.\nMaintenez pour parler, relâchez pour transcrire."
