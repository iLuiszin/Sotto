    "Sotto" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true
    },
    "Sotto needs your microphone to transcribe speech. Your audio is processed locally on your Mac — nothing is sent to the cloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto benötigt dein Mikrofon zur Spracherkennung. Dein Audio wird lokal auf deinem Mac verarbeitet – nichts wird in die Cloud gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto necesita tu micrófono para transcribir voz. El audio se procesa localmente en tu Mac — nada se envía a la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto a besoin de votre microphone pour transcrire la parole. L'audio est traité localement sur votre Mac — rien n'est envoyé dans le cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto は音声を文字起こしするためにマイクが必要です。音声はすべて Mac 上でローカル処理され、クラウドには送信されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sotto precisa do seu microfone para transcrever fala. O áudio é processado localmente no seu Mac — nada é enviado para a nuvem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 需要使用麦克风来转录语音。音频在本机处理，不会上传到云端。"
          }
        }
      }
    },
    "Sotto uses Meet's captions to tell who is speaking. Turn them on with the CC button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto erkennt anhand der Meet-Untertitel, wer spricht. Aktiviere sie mit der CC-Taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto usa los subtítulos de Meet para saber quién habla. Actívalos con el botón CC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto utilise les sous-titres de Meet pour savoir qui parle. Activez-les avec le bouton CC."
