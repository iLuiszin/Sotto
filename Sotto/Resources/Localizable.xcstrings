    "Allow Microphone Access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonzugriff erlauben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso al micrófono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès au microphone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスを許可"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso ao microfone"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许麦克风访问"
          }
        }
      }
    },
    "Also records what other apps play, like the other side of a call. Use headphones so your microphone doesn't pick it up twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt auch auf, was andere Apps abspielen, etwa die Gegenseite eines Anrufs. Verwende Kopfhörer, damit dein Mikrofon es nicht doppelt aufnimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También graba lo que reproducen otras apps, como la otra parte de una llamada. Usa auriculares para que tu micrófono no lo capte dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre aussi ce que jouent les autres apps, comme l’autre côté d’un appel. Utilisez un casque pour que votre micro ne le capte pas deux fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話の相手の声など、他のアプリが再生する音声も録音します。マイクが二重に拾わないよう、ヘッドフォンを使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também grava o que outros apps tocam, como o outro lado de uma chamada. Use fones de ouvido para o microfone não captar o áudio duas vezes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时录制其他应用播放的声音，例如通话的另一方。请使用耳机，以免麦克风重复收音。"
          }
        }
      }
    },
