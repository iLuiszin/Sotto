        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディクテーションを起動するキーを選んでください。\n押し続けて話し、離すと文字起こしされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma tecla para ativar o ditado.\nSegure para falar, solte para transcrever."
